{
  "version": 3,
  "agents": {
    "defaults": {
      "workspace": "/var/lib/picoclaw/.picoclaw/workspace",
      "model_name": "fatfish",
      "max_tokens": 8192,
      "context_window": 131072
    }
  },
  "model_list": [
    {
      "model_name": "fatfish",
      "model": "deepseek/deepseek-flash",
      "api_base": "http://127.0.0.1:18791/v1",
      "api_keys": ["REPLACE_WITH_LOCAL_GATEWAY_TOKEN"]
    }
  ],
  "tools": {
    "mcp": {
      "enabled": true,
      "discovery": {
        "enabled": true,
        "ttl": 5,
        "max_search_results": 3,
        "use_bm25": true,
        "use_regex": true
      },
      "servers": {
        "reader": {
          "enabled": true,
          "deferred": true,
          "type": "http",
          "url": "http://127.0.0.1:18792/mcp",
          "headers": {"Authorization": "Bearer REPLACE_WITH_LOCAL_READER_TOKEN"}
        },
        "deepseek": {
          "enabled": true,
          "deferred": true,
          "type": "stdio",
          "command": "/usr/bin/python3",
          "args": ["/opt/picoclaw/fatfish-v1/deepseek-search-mcp.py"]
        }
      }
    }
  }
}
